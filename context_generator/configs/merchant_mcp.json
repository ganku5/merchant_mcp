{
  "repo_name": "newton-hs",
  "source_of_truth": "codebase",
  "documentation_focus": "Newton merchant server-to-server API integration guide",
  "include_globs": [
    "*.hs",
    "**/*.hs",
    "*.lhs",
    "**/*.lhs",
    "*.cabal",
    "**/*.cabal",
    "*.dhall",
    "**/*.dhall",
    "*.yaml",
    "**/*.yaml",
    "*.yml",
    "**/*.yml",
    "*.json",
    "**/*.json"
  ],
  "exclude_globs": [
    "data/**",
    "context_generator/generated/**",
    "**/__pycache__/**",
    ".git/**",
    "**/.git/**",
    "dist-newstyle/**",
    "**/dist-newstyle/**",
    ".stack-work/**",
    "**/.stack-work/**",
    "node_modules/**",
    "**/node_modules/**"
  ],
  "priority_path_keywords": [
    "src/Newton/Types/API/ServerToServer/Transaction.hs",
    "src/Newton/App/Routes/Core.hs",
    "src/Newton/Product/MerchantTransactionsV2.hs",
    "src/Newton/Services/Transformer/ServerToServer/RegisterIntent.hs",
    "src/Newton/Services/Transformer/ServerToServer/Types.hs",
    "src/Newton/Services/Transformer/ServerToServer/Core.hs",
    "src/Newton/Services/Transformer/ServerToServer/Helper.hs",
    "src/Newton/Types/Domain/Constants.hs",
    "src/Newton/Constants/APIErrorCode.hs"
  ],
  "contract_keywords": [
    "Request",
    "Response",
    "Payload",
    "merchantRequestId",
    "responseCode",
    "responseMessage",
    "gatewayTransactionId",
    "orderId",
    "BAD_REQUEST",
    "DUPLICATE_REQUEST",
    "REQUEST_PENDING",
    "REQUEST_EXPIRED",
    "payeeVpa",
    "dynamic VPA",
    "firstExecutionAmount",
    "applyRefundOnSuccess",
    "subMerchantDetails",
    "tpvType",
    "splitSettlementDetails",
    "intentRequestExpiryMinutes",
    "intentRequestExpirySeconds"
  ],
  "forbidden_output_terms": [
    "predicate",
    "transformer",
    "handler",
    "source file",
    ".hs",
    "code path",
    "backend flow",
    "internal implementation"
  ],
  "required_sections": [
    "Overview",
    "Business Use Case",
    "Integration Flow",
    "Endpoint",
    "Request",
    "Response",
    "Error Handling",
    "Retry / Status Guidance"
  ],
  "deprioritize_path_keywords": [
    "src/Newton/Types/API/OpsDashboard.hs",
    "src/Newton/Utils/Transformers/",
    "src/Newton/Services/Transformer/SDK/",
    "src/Newton/Services/Transformer/Icici/",
    "src/Newton/External/MerchantCallback/",
    "src/Newton/Utils/DashboardTransformer.hs",
    "src/Newton/Types/API/ServerToServer/Mandate.hs",
    "src/Newton/Data/Accessor.hs",
    "stan_report",
    "ChangeLog",
    "DeploymentInstructions",
    "db_schema",
    "db_config"
  ],
  "style_guide": {
    "source_of_facts": "configured codebase only",
    "style_reference": "existing Newton server-to-server API docs",
    "preferred_structure": [
      "Title",
      "Source endpoint",
      "Overview",
      "Business Use Case",
      "Integration Flow",
      "Endpoint",
      "Recommended headers",
      "Path and Version Parameters",
      "Request",
      "Required Minimum",
      "Field Reference",
      "Defaults and Omitted Field Behavior",
      "Response",
      "Success Response",
      "Error Handling",
      "Retry / Status Guidance"
    ]
  }
}
